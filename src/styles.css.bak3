@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  color-scheme: dark;
  --ink: #070912;
  --ink-soft: #0d1020;
  --ink-lift: #161a2e;
  --paper: #f3f5fb;
  --paper-dim: #a9aec6;
  --muted: #7e84a3;
  --accent: #6d5dfc;
  --accent-hot: #5a4af0;
  --accent-2: #3ee6c4;
  --line: rgba(243, 245, 251, .14);
  --line-dark: rgba(7, 9, 18, .14);
  --mono: 'DM Mono', ui-monospace, monospace;
  --sans: 'Manrope', ui-sans-serif, system-ui, sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body { margin: 0; background: var(--ink); color: var(--paper); font-family: var(--sans); font-size: 15px; line-height: 1.55; }
button, input, textarea, select { font: inherit; }
button, a { -webkit-tap-highlight-color: transparent; }
a { color: inherit; text-decoration: none; }
button { color: inherit; border: 0; cursor: pointer; }
::selection { background: var(--accent); color: var(--ink); }

.site-shell { min-height: 100vh; overflow: hidden; position: relative; }
.grain { position: fixed; z-index: 20; inset: 0; opacity: .035; pointer-events: none; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 160 160' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.8'/%3E%3C/svg%3E"); }
.section-pad { padding: 132px clamp(24px, 6.4vw, 104px); }
.site-header { height: 86px; display: flex; align-items: center; justify-content: space-between; padding: 0 clamp(24px, 6.4vw, 104px); border-bottom: 1px solid var(--line); position: relative; z-index: 30; }
.wordmark { display: inline-flex; align-items: center; gap: 11px; font-size: 12px; letter-spacing: .18em; font-weight: 800; }
.wordmark-mark { display: grid; width: 29px; height: 29px; place-items: center; background: var(--accent); color: var(--ink); border-radius: 50%; font-size: 10px; letter-spacing: -.08em; }
.wordmark-text span { color: var(--accent); }
.main-nav { display: flex; align-items: center; gap: clamp(20px, 3.1vw, 48px); font-size: 12px; color: var(--paper-dim); }
.main-nav a { transition: color .25s ease; }
.main-nav a:hover { color: var(--paper); }
.nav-cta { display: flex; align-items: center; gap: 9px; padding: 10px 0 10px 21px; margin-left: 5px; border-left: 1px solid var(--line); background: transparent; color: var(--paper); font-size: 12px; }
.nav-cta svg { color: var(--accent); transition: transform .25s ease; }
.nav-cta:hover svg { transform: translateX(4px); }
.menu-toggle { display: none; background: transparent; }

.hero { min-height: 700px; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(360px, .95fr); gap: 7vw; align-items: center; padding-top: 80px; padding-bottom: 100px; position: relative; }
.hero-copy { position: relative; z-index: 2; }
.eyebrow, .section-kicker, .hero-proof, .service-index, .project-meta, .form-heading, .form-footnote, .avatar-topline, .avatar-caption, .placeholder-label, .placeholder-note { font-family: var(--mono); text-transform: uppercase; letter-spacing: .11em; font-size: 10px; }
.eyebrow { display: flex; align-items: center; gap: 10px; color: var(--paper-dim); margin-bottom: 28px; }
.eyebrow-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 5px rgba(109, 93, 252, .12); }
.eyebrow-slash { color: var(--accent); }
.hero-name { margin: 0 0 13px; color: var(--accent); font-family: var(--mono); font-size: 10px; letter-spacing: .16em; text-transform: uppercase; }
.hero h1, h2 { letter-spacing: -.07em; line-height: .96; font-weight: 700; margin: 0; }
.hero h1 { max-width: 800px; font-size: clamp(58px, 7.3vw, 116px); }
.hero h1 em, h2 em { color: var(--accent); font-style: normal; }
.hero-lede { max-width: 470px; margin: 35px 0 0; color: var(--paper-dim); font-size: 16px; line-height: 1.7; }
.hero-actions { display: flex; align-items: center; gap: 27px; margin-top: 38px; }
.button { display: inline-flex; align-items: center; justify-content: center; gap: 17px; min-height: 50px; padding: 0 21px; font-size: 12px; font-weight: 700; transition: transform .25s ease, background .25s ease, color .25s ease; }
.button:hover { transform: translateY(-3px); }
.button-primary { background: var(--accent); color: var(--ink); }
.button-primary:hover { background: var(--accent-hot); }
.button-ghost { padding-left: 0; padding-right: 0; color: var(--paper); }
.button-line { display: block; width: 31px; height: 1px; background: var(--accent); transition: width .25s ease; }
.button-ghost:hover .button-line { width: 48px; }
.hero-proof { display: flex; align-items: center; gap: 13px; color: var(--muted); margin-top: 66px; }
.hero-proof strong { color: var(--paper); font-weight: 400; }
.hero-proof .proof-divider { height: 1px; width: 30px; background: var(--line); margin-left: 14px; }
.hero-visual { min-height: 510px; position: relative; display: grid; place-items: center; }
.hero-avatar { width: min(31vw, 410px); height: min(39vw, 510px); min-height: 390px; position: relative; display: flex; flex-direction: column; justify-content: center; align-items: center; background: radial-gradient(circle at 45% 35%, #2b2f5c, #141830 44%, #080a14 100%); border: 1px solid rgba(243, 245, 251, .24); border-radius: 48% 52% 47% 53% / 39% 36% 64% 61%; box-shadow: 26px 34px 0 rgba(109, 93, 252, .9); transform: rotate(4deg); z-index: 2; overflow: hidden; }
.hero-avatar::before, .hero-avatar::after { content: ''; position: absolute; border: 1px solid rgba(243, 245, 251, .12); border-radius: 50%; }
.hero-avatar::before { width: 220px; height: 220px; top: 17%; left: 14%; }
.hero-avatar::after { width: 120px; height: 120px; right: 9%; bottom: 11%; background: var(--accent-2); border: 0; opacity: .9; mix-blend-mode: screen; }
.avatar-topline { align-self: stretch; position: absolute; top: 20%; text-align: center; color: var(--paper-dim); transform: rotate(-4deg); }
.avatar-initials { font-size: clamp(80px, 12vw, 170px); font-weight: 800; line-height: 1; letter-spacing: -.18em; margin-left: -.1em; color: transparent; -webkit-text-stroke: 1px rgba(243, 245, 251, .72); transform: rotate(-4deg); }
.avatar-caption { position: absolute; bottom: 19%; color: var(--paper-dim); text-align: center; transform: rotate(-4deg); line-height: 1.8; }
.hero-orbit { position: absolute; border: 1px solid var(--line); border-radius: 50%; transform: rotate(-25deg); }
.orbit-one { width: 124%; height: 63%; }
.orbit-two { width: 78%; height: 113%; transform: rotate(27deg); border-color: rgba(109, 93, 252, .35); }
.hero-tag { position: absolute; z-index: 3; color: var(--paper); font-family: var(--mono); font-size: 10px; line-height: 1.5; text-transform: uppercase; letter-spacing: .11em; }
.tag-top { top: 10%; right: 2%; display: flex; gap: 10px; color: var(--accent); }
.tag-top span { color: var(--paper-dim); }
.tag-bottom { bottom: 7%; left: 4%; display: flex; align-items: flex-end; gap: 12px; color: var(--paper-dim); }
.tag-bottom svg { color: var(--accent); transform: rotate(90deg); }
.hero-cross { position: absolute; color: var(--accent); font-size: 26px; font-weight: 300; }
.cross-one { top: 19%; left: 6%; }.cross-two { right: 5%; bottom: 15%; color: var(--accent-2); }

.marquee { overflow: hidden; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 20px 0; color: var(--paper-dim); font-family: var(--mono); font-size: 11px; letter-spacing: .12em; white-space: nowrap; }
.marquee-track { display: flex; gap: 25px; align-items: center; width: max-content; animation: marquee 30s linear infinite; }
.marquee b { color: var(--accent); font-size: 16px; font-weight: 400; }
@keyframes marquee { to { transform: translateX(-50%); } }

.section-kicker { color: var(--accent); margin: 0 0 28px; }
.section-intro h2, .section-heading-row h2, .diff-statement h2, .contact-intro h2 { font-size: clamp(44px, 5.3vw, 80px); }
.about { display: grid; grid-template-columns: .8fr 1.2fr; gap: 11vw; background: var(--paper); color: var(--ink); }
.about .section-kicker { color: var(--accent); }.about h2 em { color: var(--accent); }
.about-content { padding-top: 18px; }.about-lede { max-width: 670px; font-size: clamp(23px, 2.2vw, 34px); line-height: 1.25; letter-spacing: -.045em; margin: 0; }.about-lede strong { font-weight: 700; }
.about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; max-width: 650px; margin-top: 50px; color: #4f5470; line-height: 1.75; }.about-grid p { margin: 0; }
.tool-row { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: 650px; border-top: 1px solid var(--line-dark); margin-top: 52px; padding-top: 19px; color: #6b7190; font-family: var(--mono); text-transform: uppercase; font-size: 9px; letter-spacing: .1em; }.tool-list { display: flex; gap: 7px; }.tool-list b { display: grid; width: 34px; height: 34px; place-items: center; border: 1px solid var(--line-dark); color: var(--ink); font-size: 10px; font-family: var(--sans); }

.services { background: var(--ink-soft); }.section-heading-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 40px; }.section-note { max-width: 335px; margin: 0 0 5px; color: var(--paper-dim); line-height: 1.7; }.services-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; background: var(--line); margin-top: 72px; border: 1px solid var(--line); }.service-card { min-height: 325px; padding: 25px 25px 23px; background: var(--ink-soft); display: flex; flex-direction: column; transition: background .25s ease, transform .25s ease; }.service-card:hover { background: var(--ink-lift); transform: translateY(-5px); position: relative; z-index: 1; }.service-card-top { display: flex; justify-content: space-between; align-items: flex-start; }.service-index { color: var(--muted); }.service-icon { color: var(--accent); }.service-card h3 { max-width: 200px; margin: auto 0 14px; font-size: 18px; line-height: 1.17; letter-spacing: -.04em; }.service-card p { max-width: 245px; min-height: 76px; margin: 0; color: var(--muted); font-size: 12px; line-height: 1.65; }.text-button { display: inline-flex; align-items: center; gap: 12px; padding: 0; margin-top: 24px; background: transparent; font-family: var(--mono); font-size: 10px; letter-spacing: .05em; text-transform: uppercase; text-align: left; }.text-button svg { color: var(--accent); transition: transform .25s ease; }.text-button:hover svg { transform: translateX(4px); }

.portfolio { background: var(--paper); color: var(--ink); }.portfolio .section-kicker { color: var(--accent); }.portfolio h2 em { color: var(--accent); }.portfolio-count { display: flex; flex-direction: column; align-items: flex-end; font-size: 56px; font-weight: 700; line-height: .8; letter-spacing: -.09em; }.portfolio-count small { color: #727897; font-family: var(--mono); font-size: 9px; font-weight: 400; letter-spacing: .1em; line-height: 2; text-transform: uppercase; }.project-list { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; margin-top: 78px; }.project-card { background: #e6eaf6; padding: 19px; transition: transform .3s ease; }.project-card:hover { transform: translateY(-7px); }.project-card:nth-child(3) { grid-column: 1 / -1; }.project-card:nth-child(3) .project-visual { min-height: 310px; }.project-card:nth-child(4), .project-card:nth-child(5) { background: #e0e5f3; }.project-meta { display: flex; justify-content: space-between; color: #6c7292; margin-bottom: 17px; }.project-visual { min-height: 310px; display: grid; place-items: center; position: relative; overflow: hidden; background: #b7c3ff; }.project-card.lime .project-visual { background: var(--accent-2); }.project-card.violet .project-visual { background: #d2b9ff; }.project-card.gold .project-visual { background: #ffd36e; }.project-card.blue .project-visual { background: #7fdcf5; }.project-visual::before { content: ''; position: absolute; inset: 11%; border: 1px solid rgba(7, 9, 18, .32); border-radius: 50%; transform: rotate(27deg); }.project-shape { position: absolute; border-radius: 50%; background: rgba(7, 9, 18, .9); }.shape-one { width: 24%; aspect-ratio: 1; left: 17%; top: 24%; }.shape-two { width: 12%; aspect-ratio: 1; right: 22%; bottom: 20%; background: var(--accent); }.project-word { position: relative; z-index: 1; font-size: clamp(32px, 4.4vw, 68px); letter-spacing: -.09em; font-weight: 800; text-transform: uppercase; mix-blend-mode: multiply; }.project-word span { color: var(--accent); }.placeholder-label { position: absolute; right: 20px; bottom: 17px; color: rgba(7, 9, 18, .6); text-align: right; line-height: 1.5; }.project-slots { position: absolute; z-index: 2; left: 20px; bottom: 17px; display: flex; gap: 5px; }.project-slots span { display: grid; width: 31px; height: 31px; place-items: center; border: 1px dashed rgba(7, 9, 18, .48); color: rgba(7, 9, 18, .62); font-family: var(--mono); font-size: 8px; }.project-info { display: flex; justify-content: space-between; gap: 25px; padding: 24px 1px 2px; }.project-info h3 { margin: 0; font-size: 21px; letter-spacing: -.04em; }.project-info p { max-width: 430px; margin: 9px 0 0; color: #5d6382; font-size: 12px; line-height: 1.6; }.project-link { display: inline-flex; align-items: center; align-self: flex-end; flex: 0 0 auto; gap: 11px; padding: 10px 0 7px; background: transparent; border-bottom: 1px solid rgba(7, 9, 18, .45); font-family: var(--mono); font-size: 10px; letter-spacing: .06em; text-transform: uppercase; }.project-link svg { color: var(--accent); transition: transform .25s ease; }.project-link:hover svg { transform: translateX(4px); }

.process { background: var(--ink); }.process-list { display: grid; grid-template-columns: repeat(4, 1fr); gap: 35px; margin-top: 80px; }.process-step { position: relative; }.process-number { color: var(--accent); font-family: var(--mono); font-size: 11px; }.process-line { height: 1px; margin: 20px 0 25px; background: var(--line); }.process-line span { display: block; height: 1px; background: var(--accent); }.process-step h3 { margin: 0; font-size: 21px; letter-spacing: -.04em; }.process-step p { max-width: 220px; margin: 13px 0 0; color: var(--muted); font-size: 12px; line-height: 1.7; }

.differentiators { display: grid; grid-template-columns: .9fr 1.1fr; gap: 10vw; background: var(--accent); color: var(--ink); }.differentiators .section-kicker { color: rgba(7, 9, 18, .65); }.diff-statement h2 em { color: var(--paper); }.diff-statement > p:not(.section-kicker) { max-width: 330px; margin: 30px 0 35px; color: rgba(7, 9, 18, .7); }.diff-statement .button-primary { background: var(--ink); color: var(--paper); }.diff-statement .button-primary:hover { background: #1d2240; }.diff-list { border-top: 1px solid rgba(7, 9, 18, .23); }.diff-item { display: grid; grid-template-columns: 45px 1fr 24px; align-items: center; gap: 15px; min-height: 72px; border-bottom: 1px solid rgba(7, 9, 18, .23); }.diff-item span { font-family: var(--mono); font-size: 10px; color: rgba(7, 9, 18, .56); }.diff-item p { margin: 0; font-size: 14px; font-weight: 600; letter-spacing: -.02em; }.diff-item svg { color: rgba(7, 9, 18, .75); }

.testimonials { background: var(--ink-soft); }.quote-mark { color: var(--accent); opacity: .8; }.testimonial-placeholder { display: flex; align-items: center; gap: 21px; margin-top: 76px; padding: 27px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: var(--muted); }.placeholder-avatar { display: grid; width: 54px; height: 54px; place-items: center; border: 1px dashed var(--muted); border-radius: 50%; }.testimonial-placeholder p { margin: 0 0 4px; color: var(--paper-dim); font-size: 18px; }.testimonial-placeholder span { font-family: var(--mono); text-transform: uppercase; font-size: 9px; letter-spacing: .08em; }.testimonial-placeholder .placeholder-note { margin-left: auto; color: var(--accent); text-align: right; line-height: 1.7; }

.contact { display: grid; grid-template-columns: .9fr 1.1fr; gap: 9vw; background: var(--paper); color: var(--ink); }.contact .section-kicker { color: var(--accent); }.contact-intro > p:not(.section-kicker) { max-width: 420px; margin: 32px 0 0; color: #5d6382; line-height: 1.7; }.contact-details { display: flex; flex-direction: column; gap: 21px; margin-top: 55px; }.contact-details > * { display: flex; align-items: center; gap: 13px; color: var(--ink); }.contact-details a:hover .detail-icon { background: var(--accent); }.detail-icon { display: grid; width: 35px; height: 35px; place-items: center; border: 1px solid var(--line-dark); border-radius: 50%; transition: background .25s ease; }.contact-details small { display: block; margin-bottom: 2px; color: #7d83a3; font-family: var(--mono); font-size: 9px; letter-spacing: .1em; text-transform: uppercase; }.contact-details span:not(.detail-icon) { font-size: 13px; }.editable { color: var(--accent); font-weight: 600; }.contact-form-wrap { min-height: 500px; }.contact-form { padding: 34px 35px 31px; background: #e6eaf6; }.form-heading { display: flex; align-items: center; gap: 18px; padding-bottom: 25px; margin-bottom: 13px; color: #7d83a3; border-bottom: 1px solid var(--line-dark); }.form-heading span { color: var(--accent); }.form-heading p { margin: 0; }.contact-form label { display: block; padding: 20px 0 0; color: #6c7292; font-family: var(--mono); font-size: 9px; letter-spacing: .08em; text-transform: uppercase; }.contact-form input, .contact-form textarea, .contact-form select { display: block; width: 100%; padding: 12px 0; color: var(--ink); background: transparent; border: 0; border-bottom: 1px solid var(--line-dark); border-radius: 0; outline: 0; font-family: var(--sans); font-size: 14px; letter-spacing: 0; resize: vertical; }.contact-form input:focus, .contact-form textarea:focus, .contact-form select:focus { border-bottom-color: var(--accent); }.contact-form input::placeholder, .contact-form textarea::placeholder { color: #8a90ad; }.contact-form select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, #70769a 50%), linear-gradient(135deg, #70769a 50%, transparent 50%); background-position: calc(100% - 7px) 18px, calc(100% - 2px) 18px; background-size: 5px 5px, 5px 5px; background-repeat: no-repeat; }.submit-button { margin-top: 32px; }.form-footnote { margin: 17px 0 0; color: #858bab; line-height: 1.7; text-transform: none; letter-spacing: 0; }.form-success { min-height: 500px; display: flex; flex-direction: column; align-items: flex-start; justify-content: center; padding: 40px; background: #e6eaf6; }.success-icon { display: grid; width: 60px; height: 60px; margin-bottom: 30px; place-items: center; border-radius: 50%; background: var(--accent); color: var(--ink); }.form-success h3 { margin: 0; font-size: 32px; letter-spacing: -.06em; }.form-success > p:not(.section-kicker) { max-width: 390px; margin: 16px 0 25px; color: #5d6382; line-height: 1.7; }.form-success .text-button { margin-top: 20px; color: var(--ink); }

.site-footer { padding: 58px clamp(24px, 6.4vw, 104px) 25px; background: var(--ink); }.footer-top { display: grid; grid-template-columns: 1fr 1fr 1fr; align-items: start; padding-bottom: 58px; border-bottom: 1px solid var(--line); }.footer-top p { margin: 0; color: var(--muted); font-size: 12px; line-height: 1.7; }.social-links { display: flex; flex-direction: column; align-items: flex-end; gap: 9px; color: var(--paper-dim); font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: .08em; }.social-links a span { color: var(--accent); margin-left: 9px; }.social-links a:hover { color: var(--paper); }.footer-bottom { display: flex; justify-content: space-between; gap: 20px; padding-top: 19px; color: var(--muted); font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: .08em; }.footer-bottom a { color: var(--paper-dim); }.footer-bottom a:hover { color: var(--accent); }.floating-whatsapp { position: fixed; right: 25px; bottom: 24px; z-index: 15; display: flex; align-items: center; gap: 13px; padding: 12px 17px; background: var(--accent-2); color: var(--ink); box-shadow: 0 13px 30px rgba(0,0,0,.25); font-family: var(--mono); font-size: 9px; text-transform: uppercase; letter-spacing: .08em; transition: transform .25s ease; }.floating-whatsapp:hover { transform: translateY(-4px); }

.modal-backdrop { position: fixed; inset: 0; z-index: 50; display: grid; place-items: center; padding: 24px; background: rgba(3, 4, 10, .84); backdrop-filter: blur(10px); }.project-modal { position: relative; width: min(730px, 100%); max-height: calc(100vh - 48px); padding: 24px; overflow: auto; background: var(--paper); color: var(--ink); }.modal-close { position: absolute; top: 15px; right: 15px; z-index: 2; display: grid; width: 37px; height: 37px; place-items: center; border-radius: 50%; background: var(--ink); color: var(--paper); }.modal-visual { min-height: 260px; display: grid; place-items: center; position: relative; margin-bottom: 27px; overflow: hidden; background: #b7c3ff; }.modal-visual.lime { background: var(--accent-2); }.modal-visual.violet { background: #d2b9ff; }.modal-visual.gold { background: #ffd36e; }.modal-visual.blue { background: #7fdcf5; }.project-modal .section-kicker { margin-bottom: 12px; }.project-modal h2 { font-size: 40px; }.project-modal > p:not(.section-kicker) { max-width: 560px; color: #5d6382; line-height: 1.7; }.modal-shots { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin: 27px 0; }.modal-shots div { min-height: 80px; display: grid; place-items: center; background: #d9dfef; color: #7a809f; font-family: var(--mono); font-size: 9px; text-transform: uppercase; }.project-modal .button { margin-top: 7px; }

@media (max-width: 1050px) {
  .hero { gap: 4vw; }.hero h1 { font-size: clamp(56px, 7.3vw, 82px); }.services-grid { grid-template-columns: repeat(2, 1fr); }.service-card { min-height: 270px; }.project-visual { min-height: 250px; }.project-card:nth-child(3) .project-visual { min-height: 250px; }
}
@media (max-width: 760px) {
  .section-pad { padding: 88px 22px; }.site-header { height: 73px; padding: 0 22px; }.menu-toggle { display: grid; place-items: center; width: 39px; height: 39px; background: var(--ink-lift); }.main-nav { position: fixed; z-index: 25; inset: 73px 0 auto; display: none; flex-direction: column; align-items: flex-start; gap: 0; padding: 14px 22px 25px; background: var(--ink); border-bottom: 1px solid var(--line); }.main-nav.is-open { display: flex; }.main-nav a { width: 100%; padding: 14px 0; border-bottom: 1px solid var(--line); }.nav-cta { width: 100%; justify-content: space-between; padding: 17px 0 5px; margin: 0; border-left: 0; }.hero { min-height: auto; display: flex; flex-direction: column; align-items: stretch; gap: 60px; padding-top: 80px; }.hero h1 { font-size: clamp(53px, 15vw, 76px); }.hero-lede { font-size: 14px; }.hero-proof { flex-wrap: wrap; margin-top: 50px; line-height: 1.5; }.hero-visual { min-height: 410px; }.hero-avatar { width: min(76vw, 330px); height: min(95vw, 420px); min-height: 350px; }.orbit-one { width: 115%; }.orbit-two { width: 86%; height: 108%; }.tag-top { right: 4%; }.tag-bottom { left: 0; }.about, .differentiators, .contact { display: flex; flex-direction: column; gap: 55px; }.about-content { padding: 0; }.about-grid { grid-template-columns: 1fr; gap: 18px; margin-top: 35px; }.tool-row { align-items: flex-start; flex-direction: column; margin-top: 36px; }.section-heading-row { align-items: flex-start; flex-direction: column; gap: 30px; }.section-note { max-width: 400px; }.services-grid { grid-template-columns: 1fr 1fr; margin-top: 52px; }.service-card { min-height: 300px; padding: 20px 17px; }.service-card h3 { font-size: 16px; }.service-card p { font-size: 11px; }.project-list { grid-template-columns: 1fr; margin-top: 53px; }.project-card:nth-child(3) { grid-column: auto; }.project-card:nth-child(3) .project-visual, .project-visual { min-height: 260px; }.process-list { grid-template-columns: 1fr 1fr; gap: 42px 20px; margin-top: 52px; }.process-line { margin: 14px 0 19px; }.diff-statement > p:not(.section-kicker) { margin-top: 22px; }.diff-list { width: 100%; }.testimonial-placeholder { margin-top: 52px; }.testimonial-placeholder p { font-size: 15px; }.contact-form-wrap { min-height: unset; }.contact-form, .form-success { padding: 25px 20px; }.footer-top { grid-template-columns: 1fr 1fr; gap: 35px 20px; }.footer-top p { grid-column: 1 / -1; grid-row: 2; }.social-links { align-items: flex-start; }.footer-bottom { flex-wrap: wrap; line-height: 1.7; }.floating-whatsapp { right: 15px; bottom: 15px; }.floating-whatsapp span { display: none; }.floating-whatsapp { width: 48px; height: 48px; justify-content: center; border-radius: 50%; padding: 0; }
}
@media (max-width: 450px) { .services-grid { grid-template-columns: 1fr; }.service-card { min-height: 250px; }.hero-actions { align-items: flex-start; flex-direction: column; gap: 20px; }.hero-proof { gap: 10px; }.hero-proof .proof-divider { width: 20px; margin-left: 3px; }.project-info { gap: 15px; }.project-info h3 { font-size: 18px; }.project-info p { font-size: 11px; }.process-list { grid-template-columns: 1fr; }.process-step p { max-width: 100%; }.portfolio-count { font-size: 45px; }.modal-shots { grid-template-columns: 1fr 1fr; }.modal-shots div:last-child { grid-column: 1 / -1; }.project-modal h2 { font-size: 33px; } }
@media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }

/* === MODERN PALETTE OVERRIDES === */
.about, .portfolio, .contact, .project-modal { --accent: #5240e8; --accent-hot: #3f2fd0; }
::selection { background: var(--accent); color: #fff; }
.wordmark-mark, .success-icon, .button-primary { color: #fff; }

.hero {
  background:
    radial-gradient(60% 50% at 80% 30%, rgba(109, 93, 252, .22), transparent 70%),
    radial-gradient(40% 40% at 10% 90%, rgba(62, 230, 196, .10), transparent 70%);
}
.hero-avatar { box-shadow: 0 40px 100px rgba(109, 93, 252, .35), 0 0 0 1px rgba(243, 245, 251, .08); }

.differentiators { background: linear-gradient(135deg, #4a37e0, #6d5dfc 55%, #8a6bff); color: #fff; }
.differentiators .section-kicker { color: rgba(255, 255, 255, .75); }
.diff-statement h2 em { color: var(--accent-2); }
.diff-statement > p:not(.section-kicker) { color: rgba(255, 255, 255, .82); }
.diff-statement .button-primary { background: #fff; color: var(--ink); }
.diff-statement .button-primary:hover { background: var(--accent-2); }
.diff-list, .diff-item { border-color: rgba(255, 255, 255, .25); }
.diff-item span { color: rgba(255, 255, 255, .7); }
.diff-item svg { color: #fff; }
/* === HERO GIF === */
.hero-gif {
  position: relative;
  z-index: 2;
  width: min(38vw, 520px);
  aspect-ratio: 1 / .92;
  overflow: hidden;
  -webkit-mask-image: linear-gradient(to bottom, #000 78%, transparent);
  mask-image: linear-gradient(to bottom, #000 78%, transparent);
}
.hero-gif img { display: block; width: 100%; height: auto; }
@media (max-width: 1050px) { .hero-gif { width: min(42vw, 440px); } }
@media (max-width: 760px) { .hero-gif { width: min(84vw, 420px); } }